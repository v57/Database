{
  "build": { "scheme": "Database", "project": "Database.xcodeproj" },
  "appearances": ["light", "dark"],
  "variables": { "DATA": "$ROOT/.build/screenshots-demo/data" },
  "watch": ["Database", "Sources", "Scripts/seed-demo.py", "Scripts/screenshot-demo.sh"],
  "mac": { "window": [1440, 900] },
  "ios": { "devices": ["iPhone 18 Pro Max", "iPad Pro 13-inch (M5)"] },
  "scenes": [
    {
      "id": "01-browse",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Shop/shop/orders", "--select-row", "1"],
      "delay": 6,
      "caption": "Browse any table without writing SQL"
    },
    {
      "id": "02-documents",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Catalog/catalog/products", "--view", "cards", "--select-row", "0"],
      "delay": 6,
      "caption": "Documents as cards, JSON or a table"
    },
    {
      "id": "03-aggregation",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Catalog/catalog/reviews", "--mode", "aggregate", "--full-builder", "--demo-pipeline"],
      "delay": 7,
      "caption": "Build aggregation pipelines step by step"
    },
    {
      "id": "04-keys",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Sessions/Database 0", "--select-key", "leaderboard:weekly"],
      "delay": 6,
      "caption": "Every Redis key with its type and expiry"
    },
    {
      "id": "05-query",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Shop", "--new-query", "SELECT c.city, count(*) AS orders, sum(o.total) AS revenue\nFROM orders o\nJOIN customers c ON c.id = o.customer_id\nGROUP BY c.city\nORDER BY revenue DESC;", "--run"],
      "delay": 6,
      "caption": "Write SQL with completions and run it"
    },
    {
      "id": "06-review",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Shop/shop/orders", "--select-row", "0", "--stage-edit", "status=pending", "--stage-delete"],
      "delay": 6,
      "caption": "Review every change before it's saved"
    },
    {
      "id": "07-connect",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--new-connection", "postgresql://analyst@db.example.com:5432/warehouse?sslmode=require"],
      "delay": 4,
      "caption": "Paste a link to connect"
    },
    {
      "id": "08-wide-column",
      "platforms": ["mac"],
      "arguments": ["--data-dir", "$DATA", "--present", "--select", "Telemetry/telemetry/readings", "--select-row", "0"],
      "delay": 7,
      "caption": "Cassandra and ScyllaDB tables too"
    },

    {
      "id": "01-connections-iphone",
      "platforms": ["iphone"],
      "arguments": ["--data-dir", "$DATA"],
      "delay": 4,
      "caption": "Ten databases in your pocket",
      "relaunch": true
    },
    {
      "id": "02-orders-iphone",
      "platforms": ["iphone"],
      "arguments": ["--data-dir", "$DATA", "--select", "Shop/shop/orders"],
      "delay": 6,
      "caption": "Browse any table without writing SQL",
      "relaunch": true
    },
    {
      "id": "03-documents-iphone",
      "platforms": ["iphone"],
      "arguments": ["--data-dir", "$DATA", "--select", "Catalog/catalog/products", "--view", "cards"],
      "delay": 6,
      "caption": "Documents as cards, JSON or a table",
      "relaunch": true
    },
    {
      "id": "04-keys-iphone",
      "platforms": ["iphone"],
      "arguments": ["--data-dir", "$DATA", "--select", "Sessions/Database 0"],
      "delay": 6,
      "caption": "Every Redis key with its type and expiry",
      "relaunch": true
    },

    {
      "id": "01-browse-ipad",
      "platforms": ["ipad"],
      "arguments": ["--data-dir", "$DATA", "--hide-sidebar", "--select", "Shop/shop/orders", "--select-row", "1"],
      "delay": 6,
      "caption": "Browse any table without writing SQL",
      "relaunch": true
    },
    {
      "id": "02-documents-ipad",
      "platforms": ["ipad"],
      "arguments": ["--data-dir", "$DATA", "--hide-sidebar", "--select", "Catalog/catalog/products", "--view", "cards", "--select-row", "0"],
      "delay": 6,
      "caption": "Documents as cards, JSON or a table",
      "relaunch": true
    },
    {
      "id": "03-aggregation-ipad",
      "platforms": ["ipad"],
      "arguments": ["--data-dir", "$DATA", "--hide-sidebar", "--select", "Catalog/catalog/reviews", "--mode", "aggregate", "--demo-pipeline"],
      "delay": 7,
      "caption": "Build aggregation pipelines step by step",
      "relaunch": true
    },
    {
      "id": "04-keys-ipad",
      "platforms": ["ipad"],
      "arguments": ["--data-dir", "$DATA", "--hide-sidebar", "--select", "Sessions/Database 0", "--select-key", "leaderboard:weekly"],
      "delay": 6,
      "caption": "Every Redis key with its type and expiry",
      "relaunch": true
    },
    {
      "id": "05-query-ipad",
      "platforms": ["ipad"],
      "arguments": ["--data-dir", "$DATA", "--hide-sidebar", "--select", "Shop", "--new-query", "SELECT c.city, count(*) AS orders, sum(o.total) AS revenue\nFROM orders o\nJOIN customers c ON c.id = o.customer_id\nGROUP BY c.city\nORDER BY revenue DESC;", "--run"],
      "delay": 6,
      "caption": "Write SQL with completions and run it",
      "relaunch": true
    }
  ]
}
