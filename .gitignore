# macOS
.DS_Store
# Finder folder icon: a file named Icon plus a carriage return
Icon[
]

# Build
.build/
build/
DerivedData/
xcuserdata/
*.xcuserstate
/.swiftpm
/App/.swiftpm

# Binaries: DuckDB, built by Scripts/build-duckdb.sh and packed by Scripts/release-binaries.sh (a download the app
# makes on request); libssh2 is ../SSH's
/Binary/

# App Store screenshots: kept outside git
/AppStore/

# Local test servers' SSH key (see docker-compose.yml)
/.testing/

# Secrets
.env

# Agents (local agent instructions, settings and boards)
CLAUDE.md
AGENTS.md
.claude/
.codex/
.commandcode/
.hermes/
KANBAN*.md
graphify-out/

# Package pins: the .xcodeproj's Package.resolved is committed and a release builds from it alone (security audit
# H2: release.sh's check). The -Local workspace and SwiftPM's own pins follow the checkouts next to this one
# (V57_LOCAL=1) or GitHub's main, so they stay unpinned
/Database.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Database.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/Package.resolved
/App/Package.resolved
/Database-Local.xcworkspace/xcshareddata/
